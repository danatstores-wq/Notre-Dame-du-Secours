rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isPriest() {
      return request.auth != null
        && request.auth.token.email == 'notredamedusecours5@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // Public visitors may read published parish content. Only the verified
    // parish priest account may create, edit, or delete it.
    match /siteContent/{contentId} {
      allow read: if true;
      allow create, update, delete: if isPriest();
    }

    // Reserved for a future private prayer-request review workflow.
    // No public submissions are enabled by these rules.
    match /prayerRequests/{requestId} {
      allow read, create, update, delete: if isPriest();
    }

    // Users may access only their own private profile document.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Everything else is denied unless explicitly allowed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}