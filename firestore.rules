rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isPriest() {
      return request.auth != null
        && request.auth.token.email == 'notredamedusecours5@gmail.com'
        && request.auth.token.email_verified == true;
    }

    match /siteContent/{contentId} {
      allow read: if true;
      allow create, update, delete: if isPriest();
    }

    // Prayer requests: verified parishioners may submit their own request.
    // Only the verified priest can review or delete requests.
    match /prayerRequests/{requestId} {
      allow create: if request.auth != null
        && request.auth.token.email_verified == true
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 5000
        && (
          !exists(/databases/$(database)/documents/users/$(request.auth.uid))
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.prayerBlocked != true
        );
      allow read: if isPriest()
        || (request.auth != null && resource.data.userId == request.auth.uid);
      allow update, delete: if isPriest();
    }

    // Users can read their own moderation status. Only the priest can change it.
    match /users/{userId} {
      allow get: if isPriest() || (request.auth != null && request.auth.uid == userId);
      allow list: if isPriest();
      allow create, update, delete: if isPriest();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}